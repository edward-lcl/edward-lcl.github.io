const experience = [
  {
    org: "Algoverse",
    role: "Research Engineer · multi-role",
    when: "Jun 2025 – present · remote",
    bullets: [
      "First author of Factor-UT (AAAI 2026 Trustworthy Agentic AI Workshop) — a control protocol for untrusted AI decomposers in code generation. Led a four-person team across evaluation design (AUROC, attack success rate, audit thresholds on BigCodeBench / Inspect AI) and the full write-up.",
      "Concurrent implementation, SOP development, and experiment coverage for 4–5 active research groups — agentic chains, eval harnesses, prompt scaffolds, statistical analysis, and paper polish, based on what each group needs to ship.",
