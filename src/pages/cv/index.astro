    ],
  },
  {
    org: "Biotechnology startup",
    role: "Research Advisor",
    when: "Jan – May 2025 · Fort Collins, CO",
    bullets: [
      "Built a cryoprotectant discovery workflow over a 9,495-molecule PostgreSQL database with RDKit fingerprint similarity (Numba-accelerated; Tanimoto, Dice, cosine), with multi-layer scoring across toxicity, physicochemical properties, and permeability.",
