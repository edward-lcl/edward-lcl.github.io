  },
  {
    org: "Colorado State University",
    role: "Student Researcher · United in STEMM",
    when: "Sep 2024 – Jun 2025 · Fort Collins, CO",
    bullets: [
      "Led a 10-person team on a human protein expression project; awarded CURC Highest Honors for innovative parameter search and workflow design.",
      "Built AI-assisted parameter-search and process-heuristic workflows that let an undergraduate team operate at graduate-level experimental throughput.",
    ],
  },
  {
    org: "Earlier roles — engineering, operations, founder",
    role: "",
    when: "2021 – 2024",
    bullets: [
      "Control Technologies Limited, Service Engineer Intern (Jun – Aug 2024): P&ID systems for automated brewery control; CCTV-PLC monitoring for compliance and traceability. Re-engaged in 2025 to build Talos & Node Zero.",
      "LAS Retail, Founder & Operator (2021 – 2023): founded and operated the first specialty cannabis accessories retail concept in Trinidad & Tobago; reached early commercial traction and executed a clean exit on relocation.",
    ],
  },
];

const skills = [
  ["AI evaluation & safety", "Inspect AI · BigCodeBench · factored cognition · untrusted decomposers · agent monitoring · adversarial evaluation · sandbagging detection · activation probing · multi-hop retrieval and memory"],
  ["Engineering", "Python · FastAPI · PostgreSQL · pgvector · SQLite · REST · RDKit · inference pipelines · Claude Code · Codex · AutoCAD · Fusion 360"],
  ["Methods & math", "ROC analysis · bootstrap CI · Cohen’s d · hypothesis testing · Wilson intervals · linear algebra · probability"],
  ["Applied research", "Experiment design and data collection in messy real environments — molecular workflows, process validation, parameter search"],
];
---

<Layout
  title="CV — Edward Lue Chee Lip"
  description="Curriculum vitae of Edward Lue Chee Lip: AI researcher and systems builder — publications, research and engineering experience, education."
>
  <header class="site-header cv-chrome">
    <div class="shell nav-inner">
      <a class="site-name" href="/"><span class="site-name-long">Edward Lue Chee Lip</span><span class="site-name-short">Edward</span></a>
      <p class="header-status"><span></span> The boring artifact, kept honest</p>
      <nav aria-label="CV navigation">
        <a href="/">← notebook</a>
        <a href="javascript:window.print()">Print / PDF</a>
        <a href={links.email}>Email ↗</a>
      </nav>
    </div>
  </header>

  <main id="main" class="cv-page shell">
    <header class="cv-head">
      <h1>Edward Lue Chee Lip</h1>
      <p class="cv-tagline">
        I study where intelligent systems lose information, control, and evidence between layers —
        and build the infrastructure that makes those losses inspectable. In practice that spans
        agentic evaluation and AI control, memory, medical-AI benchmarking, and solo-built systems
        for a capital-intensive industrial operator.
      </p>
      <p class="cv-contact">
        Trinidad &amp; Tobago · open to relocation
        · <a href={links.email}>eluecheelip@gmail.com</a>
        · <a href={links.github}>github/edward-lcl</a>
        · <a href={links.linkedin}>linkedin/edward-lue-chee-lip</a>
        · <a href="https://edward-lcl.github.io/">edward-lcl.github.io</a>
      </p>
    </header>

    <section class="cv-section">
      <h2>Publications · 2026</h2>
      <div class="cv-pubs">
        {publications.map((pub) => (
          <article class="cv-pub">
            <div class="cv-pub-main">
              <strong>{pub.title}</strong>
              <p>{pub.authors}</p>
              <p class="cv-pub-venue">
                {pub.venue} · {pub.status}
                {pub.link && <> · <a href={pub.link.url}>{pub.link.label} ↗</a></>}
              </p>
            </div>
            <span class:list={["cv-role", pub.role === "First author" && "cv-role-first"]}>{pub.role}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="cv-section">
      <h2>Research &amp; engineering experience</h2>
      {experience.map((job) => (
        <article class="cv-job">
          <div class="cv-job-head">
            <strong>{job.org}{job.role && <span> — {job.role}</span>}</strong>
            <span>{job.when}</span>
          </div>
          <ul>
            {job.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </article>
      ))}
    </section>

    <section class="cv-section">
      <h2>Skills &amp; methods</h2>
      <dl class="cv-skills">
        {skills.map(([label, body]) => (
          <div><dt>{label}</dt><dd>{body}</dd></div>
        ))}
      </dl>
    </section>

    <section class="cv-section">
      <h2>Education &amp; awards</h2>
      <div class="cv-job-head">
        <strong>Xi’an Jiaotong-Liverpool University — Artificial Intelligence (Intelligent Systems)</strong>
        <span>2026 –</span>
      </div>
      <div class="cv-job-head">
        <strong>Colorado State University — B.S. Fermentation Science</strong>
        <span>on leave</span>
      </div>
      <div class="cv-job-head">
        <strong>CURC Highest Honors — Colorado University Research Conference</strong>
        <span>Jun 2025</span>
      </div>
    </section>

    <p class="cv-footnote">
      Statuses current as of {statusDate}. The living version of this record — with per-paper
      provenance — is <a href="https://edward-lcl.github.io/">edward-lcl.github.io</a>.
    </p>
  </main>

  <footer class="site-footer cv-chrome">
    <div class="shell footer-inner">
      <div>
        <p class="footer-title">Edward Lue Chee Lip</p>
        <p>A public notebook about intelligent systems,<br />their instruments, and the worlds around them.</p>
      </div>
      <a class="footer-email" href={links.email}>eluecheelip@gmail.com</a>
      <div class="footer-links"><a href="/">Home</a><a href="/notes/">Notes</a></div>
    </div>
  </footer>
</Layout>
