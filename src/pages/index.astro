---
import Layout from "../layouts/Layout.astro";
import EvidenceSketch from "../components/EvidenceSketch.astro";
import { acceptedPapers, additionalPapers, links, researchArcs, selectedSystems, sitePositioning } from "../data/site";

const positioning = sitePositioning.en;
const visibleSystems = selectedSystems.filter((system) => !("public" in system) || system.public !== false);
const flagshipSlugs = ["recall-debt", "factor-ut"];
const flagships = flagshipSlugs
  .map((slug) => acceptedPapers.find((paper) => paper.slug === slug))
  .filter((paper) => paper !== undefined);
const collaborations = [
  ...acceptedPapers.filter((paper) => !flagshipSlugs.includes(paper.slug)),
  ...additionalPapers,
];
const allPapers = [...acceptedPapers, ...additionalPapers];
const paperCount = allPapers.length;
const firstAuthorCount = allPapers.filter((paper) => paper.role === "First author").length;
const venueList = [...new Set(allPapers.map((paper) => paper.series))].sort().join(" · ");
const featuredArcSlugs = [
  "a-zero-needs-adjudication",
  "inside-the-loop",
  "verification-must-touch-reality",
];
const featuredArcs = featuredArcSlugs.map((slug) => researchArcs.find((arc) => arc.slug === slug)).filter(Boolean);
const latestWriting = researchArcs.filter((arc) => "cluster" in arc && arc.cluster === "latest");
---

<Layout title={positioning.title} description={positioning.description}>
  <header class="site-header">
    <div class="shell nav-inner">
      <a class="site-name" href="#top"><span class="site-name-long">Edward Lue Chee Lip</span><span class="site-name-short">Edward</span></a>
      <p class="header-status"><span></span> Trinidad &amp; Tobago · intelligent systems · open research</p>
      <nav class="header-actions" aria-label="Primary navigation">
        <a class="cv-quick-link" href="/cv/">CV <span aria-hidden="true">↗</span></a>
        <a href={links.email}>Email</a>
        <a href="/zh/" lang="zh-CN">中文</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section id="top" class="hero shell">
      <div class="hero-main reveal">
        <p class="overline"><span class="status-dot"></span>A working notebook by Edward</p>
        <h1>{positioning.hero} <span>{positioning.heroEmphasis}</span></h1>
        <p class="hero-lead">
          {positioning.lead}
        </p>
        <p class="hero-question">{positioning.question} <a href={sitePositioning.frameworkUrl}>Inside the loop →</a></p>
        <div class="hero-actions">
          <a class="primary-link" href="#research">See my research <span>↓</span></a>
          <a href={links.email}>Email me <span>↗</span></a>
        </div>

        <div class="desk-note" data-note-carousel aria-label="Rotating field notes">
          <div>
            <span class="desk-note-index">Margin note <b data-note-index>01</b>/03</span>
            <p data-field-note>{positioning.notes[0]}</p>
          </div>
          <div class="note-dots" aria-label="Choose a field note">
            <button class="active" type="button" data-note-dot="0" aria-label="Show note 1" aria-pressed="true"></button>
            <button type="button" data-note-dot="1" aria-label="Show note 2" aria-pressed="false"></button>
            <button type="button" data-note-dot="2" aria-label="Show note 3" aria-pressed="false"></button>
          </div>
        </div>
      </div>

      <aside class="personal-card reveal" aria-label="Research coordinates">
        <p class="card-label">Research coordinates</p>
<figure class="author-portrait"><img src="/edward-github-avatar.png" width="460" height="460" alt="Edward’s illustrated profile portrait, from his public GitHub account" /><figcaption><a href={links.github}>Public GitHub avatar ↗</a></figcaption></figure>
        <p class="personal-note">
          From Trinidad and Tobago. Now in Suzhou, studying Artificial Intelligence
          <span> (Intelligent Systems) at XJTLU.</span>
        </p>
        <p class="personal-aside">Wet labs, industrial controls, now AI. I still start by asking how the signal was measured.</p>
        <div class="personal-index">
          <p>Quick index</p>
          <nav aria-label="Notebook index">
            <a href="#research"><span>01</span>Research</a>
            <a href="#systems"><span>02</span>Systems</a>
            <a href="#notebook"><span>03</span>Notebook</a>
            <a href="#about"><span>04</span>About</a>
            <a href="#direction"><span>05</span>Direction</a>
          </nav>
        </div>
        <div class="personal-links">
          <a href={links.github} target="_blank" rel="noopener">GitHub ↗</a>

          <a href={links.x} target="_blank" rel="noopener">X ↗</a>
        </div>
      </aside>

      <div class="hero-proof hero-proof-text reveal" aria-label="Research focus and public evidence">
        <p><span class="proof-label">Accepted work</span><strong>{paperCount} workshop papers · {firstAuthorCount} first-author<br />{venueList}</strong></p>
        <p><span class="proof-label">Working across</span><strong>memory · evaluation · agents · AI control</strong></p>
        <p><span class="proof-label">Evidence</span><strong>papers · code · experiments · system notes</strong></p>
        <p class="proof-note">The signal is useful.<br /><em>The questions matter more.</em></p>
      </div>
    </section>

    <section id="research" class="section shell">
      <div class="section-heading reveal">
        <div>
          <p class="overline">Flagship research</p>
          <h2>Two flagship papers</h2>
        </div>
        <p>
          A missing relationship can make evidence unreachable. A decomposition can hide the context
          a monitor needs. These papers locate failures at the boundary between components;
          their digests preserve the scope of each result.
        </p>
      </div>

      <div class="paper-grid">
        {flagships.map((paper, index) => {
          const Tag = paper.url ? "a" : "article";
          return (
            <Tag
              class="paper-card flagship reveal"
              href={paper.url || undefined}
            >
              <div class="paper-topline">
                <span class="paper-index">{String(index + 1).padStart(2, "0")} / {String(flagships.length).padStart(2, "0")}</span>
                <span class="accepted-pill">First author</span>
                <span>{paper.venue}</span>
              </div>
              <div class="paper-copy">
                <h3>{paper.title}</h3>
                <p class="paper-subtitle">{paper.subtitle}</p>
                <p class="paper-question">{paper.question}</p>
              </div>
              <EvidenceSketch slug={paper.slug} compact />
              <div class="paper-bottom">
                <span>{paper.note.replace("Accepted · ", "Accepted ")}</span>
                <span aria-hidden="true">Read the digest →</span>
              </div>
            </Tag>
          );
        })}
      </div>

      <div class="collab-block reveal">
        <p class="collab-label">More accepted work</p>
        <div class="collab-list">
          {collaborations.map((paper) => {
            const Tag = paper.url ? "a" : "article";
            return (
              <Tag class="collab-row" href={paper.url || undefined}>
                <span class="collab-venue">{paper.venue}</span>
                <span class="collab-title"><strong>{paper.title}</strong> — {paper.subtitle}</span>
                <span class:list={["collab-role", paper.role === "First author" && "collab-role-first"]}>{paper.role}</span>
                <span class="collab-arrow" aria-hidden="true">{paper.url ? "→" : ""}</span>
              </Tag>
            );
          })}
        </div>
      </div>

      <div class="research-footnote reveal">
        <p>Each entry opens a plain-language digest; the newest is deliberately minimal until its artifact goes public. Artifacts are linked when available.</p>
        <p>Memory, supervision, agent behavior, and measurement: different interventions into the same question of what a result lets us know.</p>
      </div>
    </section>

    <section id="systems" class="section shell systems-section">
      <div class="section-heading reveal">
        <div>
          <p class="overline">Selected work</p>
          <h2>Systems I’ve built</h2>
        </div>
        <p>
          The papers locate a failure; these systems build the missing layer. Evidence travels with
          a score, hypotheses reach an experiment, and a control signal stays attached to its instrument.
        </p>
      </div>

      <div class="systems-grid">
        {visibleSystems.map((system, index) => {
          const Tag = system.url ? "a" : "article";
          return (
            <Tag class="system-card reveal" href={system.url || undefined}>
              <span class="system-index">0{index + 1}</span>
              <div class="system-title">
                <span class="system-kind">{system.kind}</span>
                <h3>{system.name}</h3>
              </div>
              <p>{system.description}</p>
              <span class="system-link">Read the system note →</span>
            </Tag>
          );
        })}
      </div>

      <a class="all-work-link reveal" href={links.github} target="_blank" rel="noopener">Browse the wider body of work on GitHub <span>↗</span></a>
    </section>

    <section id="method" class="method-band" aria-labelledby="method-title">
      <div class="shell method-inner">
        <div class="method-copy reveal">
          <p class="overline">Operating method</p>
          <h2 id="method-title">The loop is<br />{" "}<span>an evidence system.</span></h2>
          <p>
            I debug vertically. An apparent model failure may begin in the harness; a clean score
            may conceal a broken verifier. I trace the cause across layers, bound the next action,
            and keep the evidence that lets someone else challenge the result.
          </p>
        </div>
        <div class="method-panel reveal">
          <ol class="method-loop" aria-label="Edward's six-stage operating loop">
            {["Observe", "Orient", "Plan", "Act", "Verify", "Remember"].map((step, index) => (
              <li><span>0{index + 1}</span>{step}</li>
            ))}
          </ol>
          <div class="method-links">
            <a href="/questions/build-the-missing-layer/">Open the operating loop →</a>
            <a href="/questions/systems-are-strange-loops/">One output, seven layers of cause →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="notebook" class="section themes-section">
      <div class="shell">
        <div class="section-heading reveal">
          <div>
            <p class="overline">From the notebook</p>
            <h2>Three ways in</h2>
          </div>
          <p>
            Start with an ambiguous result, follow the larger loop, then ask what could correct it.
            The papers carry findings; the notebook tests how far their questions travel.
          </p>
        </div>

        <div class="theme-grid">
          {featuredArcs.map((arc, index) => arc && (
            <a class="theme-card reveal" href={arc.url}>
              <span class="theme-number">0{index + 1}</span>
              <h3>{arc.title}</h3>
              <p>{arc.body}</p>
              <span class="theme-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
          <a class="theme-card theme-card-index reveal" href="/notes/">
            <span class="theme-number">··</span>
            <h3>The full index.</h3>
            <p>Every field note in one place — the notebook grows here first.</p>
            <span class="theme-arrow" aria-hidden="true">→</span>
          </a>
        </div>
        {latestWriting.length > 0 && (
          <p class="notes-footnote reveal" style="margin-top: 1.5rem;">
            New writing:{" "}
            {latestWriting.map((arc, i) => (
              <span>
                {i > 0 && " · "}
                <a href={arc.url}>{arc.title}</a>
              </span>
            ))}
          </p>
        )}
      </div>
    </section>

    <section id="about" class="section shell about-section">
      <div class="about-heading reveal">
        <p class="overline">About me</p>
        <h2>I debug<br />{" "}<span>vertically.</span></h2>
      </div>

      <div class="about-copy reveal">
        <p class="about-lead">
          I learned to follow a signal back to its instrument before I learned to evaluate an agent.
          I still work that way: cross the boundary, find what the measurement left out, build the missing layer.
        </p>
        <p>
          The path ran through fermentation science and wet-lab research at Colorado State,
          industrial automation in Trinidad, entrepreneurship, and now AI research. Each stop taught
          the same respect for noisy evidence and for systems that have to work outside a demo.
        </p>
      </div>

      <ol class="path-list reveal" aria-label="Edward's path">
        <li>
          <span>2023–25</span>
          <strong>Biotech & wet lab</strong>
          <p>Protein expression, cryoprotectant discovery, experimental design, and learning to distrust clean-looking signals.</p>
        </li>
        <li>
          <span>2024–26</span>
          <strong>Industry & operations</strong>
          <p>Industrial controls, P&amp;IDs, regulatory systems, entrepreneurship, and decisions with physical consequences.</p>
        </li>
        <li>
          <span>2025–now</span>
          <strong>AI research & systems</strong>
          <p>Safety, memory, agent behavior, research infrastructure, and accepted work across AI research workshops.</p>
        </li>
      </ol>
    </section>

    <section id="direction" class="now-section">
      <div class="shell now-inner">
        <div class="now-title reveal">
          <p class="overline">Working direction</p>
          <h2>Intelligence<br />{" "}<span>that can be checked.</span></h2>
        </div>
        <div class="now-copy reveal">
          <p class="now-lead">
            I’m studying Intelligent Systems at Xi’an Jiaotong-Liverpool University in Suzhou,
            while building research and infrastructure across evaluation, memory,
            AI control, and scientific discovery.
          </p>
          <p>
            My current hypothesis: keeping these systems open to correction requires independent
            ways to observe, judge, and contest them. More intelligence helps only if its errors can
            still be found. That question now takes me from agent architecture to institutions.
          </p>
          <div class="now-actions">
            <a class="primary-link" href={links.email}>Start a conversation <span>↗</span></a>
            <a href="/zh/" lang="zh-CN">中文页面 <span>→</span></a>
          </div>
        </div>
        <p class="now-marginalia reveal">Abundant capability still needs bounded action,<br /><span>inspectable evidence, and accountable consequence.</span></p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <div>
        <p class="footer-title">Edward Lue Chee Lip</p>
        <p>AI researcher and systems builder.<br />From Trinidad and Tobago; working across systems and scales.</p>
        <p class="footer-note">Built as a notebook, not a résumé.</p>
      </div>
      <a class="footer-email" href={links.email}>eluecheelip@gmail.com</a>
      <div class="footer-links">
        <a href={links.github} target="_blank" rel="noopener">GitHub</a>
        <a href="/cv/">CV</a>
        <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={links.x} target="_blank" rel="noopener">X</a>
        <a href="/zh/" lang="zh-CN">中文</a>
      </div>
    </div>
  </footer>

  <script>
    import { sitePositioning } from "../data/site";
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reducedMotion) {
      document.querySelectorAll(".reveal").forEach((element) => element.classList.add("visible"));
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.06, rootMargin: "0px 0px -4% 0px" });
      document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
    }

    const notes = sitePositioning.en.notes;
    const noteText = document.querySelector("[data-field-note]");
    const noteIndex = document.querySelector("[data-note-index]");
    const noteCarousel = document.querySelector("[data-note-carousel]");
    const noteDots = Array.from(document.querySelectorAll("[data-note-dot]"));
    let currentNote = 0;
    const showNote = (nextNote, direction) => {
      currentNote = nextNote;
      if (noteText) {
        if (direction && !reducedMotion) {
          noteText.classList.remove("note-in-left", "note-in-right");
          void noteText.offsetWidth;
          noteText.classList.add(direction === "left" ? "note-in-left" : "note-in-right");
        }
        noteText.textContent = notes[nextNote];
      }
      if (noteIndex) noteIndex.textContent = String(nextNote + 1).padStart(2, "0");
      noteDots.forEach((dot, index) => {
        const active = index === nextNote;
        dot.classList.toggle("active", active);
        dot.setAttribute("aria-pressed", String(active));
      });
    };
    noteDots.forEach((dot, index) => dot.addEventListener("click", () => {
      if (index !== currentNote) showNote(index, index > currentNote ? "left" : "right");
    }));
    let touchX = 0;
    let touchY = 0;
    noteCarousel?.addEventListener("touchstart", (event) => {
      touchX = event.touches[0].clientX;
      touchY = event.touches[0].clientY;
    }, { passive: true });
    noteCarousel?.addEventListener("touchend", (event) => {
      const deltaX = event.changedTouches[0].clientX - touchX;
      const deltaY = event.changedTouches[0].clientY - touchY;
      if (Math.abs(deltaX) < 40 || Math.abs(deltaX) < Math.abs(deltaY) * 1.2) return;
      const step = deltaX < 0 ? 1 : -1;
      showNote((currentNote + step + notes.length) % notes.length, step === 1 ? "left" : "right");
    }, { passive: true });
  </script>
</Layout>
