---
import Layout from "../layouts/Layout.astro";
import EvidenceSketch from "../components/EvidenceSketch.astro";
import StrangeLoop from "../components/StrangeLoop.astro";
import { acceptedPapers, links, researchArcs, selectedSystems } from "../data/site";

const visibleSystems = selectedSystems.filter((system) => !("public" in system) || system.public !== false);
const featuredArcSlugs = [
  "a-zero-needs-adjudication",
  "where-does-the-model-end",
  "the-frontier-is-funded",
  "verification-must-touch-reality",
];
const featuredArcs = featuredArcSlugs.map((slug) => researchArcs.find((arc) => arc.slug === slug)).filter(Boolean);
const moreArcs = researchArcs.filter((arc) => !featuredArcSlugs.includes(arc.slug));
---

<Layout title="Edward Lue Chee Lip — AI Research & Systems">
  <header class="site-header">
    <div class="shell nav-inner">
      <a class="site-name" href="#top"><span class="site-name-long">Edward Lue Chee Lip</span><span class="site-name-short">Edward</span></a>
      <p class="header-status"><span></span> Trinidad &amp; Tobago · intelligent systems · open research</p>
      <nav aria-label="Primary navigation">
        <a href="#research">Research</a>
        <a href="#systems">Systems</a>
        <a href="#work">Ideas</a>
        <a href="#about">About</a>
        <a href="#direction">Direction</a>
        <a href="/zh/" lang="zh-CN">中文</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section id="top" class="hero shell">
      <div class="hero-main reveal">
        <p class="overline"><span class="status-dot"></span>A working notebook by Edward</p>
        <h1>I research how intelligent systems <span>remember, reason, and fail.</span></h1>
        <p class="hero-lead">
          I’m an independent AI researcher and systems builder from Trinidad and Tobago. My work moves between AI safety, memory,
          agent evaluation, biomedical signals, and the infrastructure that makes ambitious ideas usable.
        </p>
        <div class="hero-actions">
          <a class="primary-link" href="#research">See my research <span>↓</span></a>
          <a href={links.email}>Email me <span>↗</span></a>
        </div>

        <div class="desk-note" data-note-carousel aria-label="Rotating field notes">
          <div>
            <span class="desk-note-index">Margin note <b data-note-index>01</b>/03</span>
            <p data-field-note>I follow consequential problems, not tidy categories.</p>
          </div>
          <div class="note-dots" aria-label="Choose a field note">
            <button class="active" type="button" data-note-dot="0" aria-label="Show note 1" aria-pressed="true"></button>
            <button type="button" data-note-dot="1" aria-label="Show note 2" aria-pressed="false"></button>
            <button type="button" data-note-dot="2" aria-label="Show note 3" aria-pressed="false"></button>
          </div>
        </div>
      </div>

      <aside class="personal-card reveal" aria-label="Research coordinates">
        <p class="card-label">Research coordinates</p>
        <div class="route-sketch" aria-hidden="true">
          <svg viewBox="0 0 360 104" role="img">
            <path class="route-path" d="M20 72 C 88 12, 164 96, 232 42 S 316 26, 340 15" />
            <path class="route-shadow" d="M20 72 C 88 12, 164 96, 232 42 S 316 26, 340 15" />
            <circle cx="20" cy="72" r="5" />
            <circle cx="340" cy="15" r="5" />
          </svg>
          <div><span>Trinidad &amp; Tobago</span><em>cross-domain by design</em><span>XJTLU</span></div>
        </div>
        <p class="personal-note">
          From Trinidad and Tobago; studying Artificial Intelligence
          <span> (Intelligent Systems) at XJTLU</span>.
        </p>
        <p class="personal-aside">The location changes. The throughline stays: follow hard problems, expose the evidence, and build the missing layer.</p>
        <div class="personal-links">
          <a href={links.github} target="_blank" rel="noopener">GitHub ↗</a>
          <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href={links.x} target="_blank" rel="noopener">X ↗</a>
        </div>
      </aside>

      <div class="hero-proof hero-proof-text reveal" aria-label="Research focus and public evidence">
        <p><span class="proof-label">Accepted work</span><strong>AAAI TrustAgent · COLM · MICCAI AMAI</strong></p>
        <p><span class="proof-label">Working across</span><strong>memory · evaluation · agents · AI control</strong></p>
        <p><span class="proof-label">Evidence</span><strong>papers · code · experiments · system notes</strong></p>
        <p class="proof-note">The signal is useful.<br /><em>The questions matter more.</em></p>
      </div>
    </section>

    <section id="research" class="section shell">
      <div class="section-heading reveal">
        <div>
          <p class="overline">Featured research</p>
          <h2>Selected accepted research</h2>
        </div>
        <p>
          These {acceptedPapers.length} public digests cover accepted work across AAAI, COLM, and MICCAI workshops. Together they ask
          how intelligent systems should be remembered, supervised, tested, calibrated, and trusted.
        </p>
      </div>

      <div class="paper-grid">
        {acceptedPapers.map((paper, index) => {
          const Tag = paper.url ? "a" : "article";
          return (
            <Tag
              class="paper-card reveal"
              href={paper.url || undefined}
            >
              <div class="paper-topline">
                <span class="paper-index">{String(index + 1).padStart(2, "0")} / {String(acceptedPapers.length).padStart(2, "0")}</span>
                <span class="accepted-pill">Accepted</span>
                <span>{paper.venue}</span>
              </div>
              <div class="paper-copy">
                <h3>{paper.title}</h3>
                <p class="paper-subtitle">{paper.subtitle}</p>
                <p class="paper-question">{paper.question}</p>
              </div>
              <EvidenceSketch slug={paper.slug} compact />
              <div class="paper-bottom">
                <span>{paper.note.replace("Accepted · ", "")}</span>
                <span aria-hidden="true">Read the digest →</span>
              </div>
            </Tag>
          );
        })}
      </div>
      <div class="research-footnote reveal">
        <p>Each card opens a plain-language digest. Public artifacts are linked from the digest when available.</p>
        <p>The papers are the visible edge of a much larger working set.</p>
      </div>
    </section>

    <section id="systems" class="section shell systems-section">
      <div class="section-heading reveal">
        <div>
          <p class="overline">Selected work</p>
          <h2>Systems I’ve built</h2>
        </div>
        <p>A small selection from a much larger body of research infrastructure, experiments, and operational tools.</p>
      </div>

      <div class="systems-grid">
        {visibleSystems.map((system, index) => {
          const Tag = system.url ? "a" : "article";
          return (
            <Tag class="system-card reveal" href={system.url || undefined}>
              <span class="system-index">0{index + 1}</span>
              <div class="system-title">
                <span class="system-kind">{system.kind}</span>
                <h3>{system.name}</h3>
              </div>
              <p>{system.description}</p>
              <span class="system-link">Read the system note →</span>
            </Tag>
          );
        })}
      </div>

      <a class="method-spine reveal" href="/questions/build-the-missing-layer/">
        <div>
          <span class="method-kicker">Operating method</span>
          <h3>The loop is an evidence system.</h3>
        </div>
        <ol aria-label="Edward's six-stage operating loop">
          {["Observe", "Orient", "Plan", "Act", "Verify", "Remember"].map((step, index) => (
            <li><span>0{index + 1}</span>{step}</li>
          ))}
        </ol>
        <strong>Open the model →</strong>
      </a>

      <a class="all-work-link reveal" href={links.github} target="_blank" rel="noopener">Browse the wider body of work on GitHub <span>↗</span></a>
    </section>

    <StrangeLoop compact />

    <section id="work" class="section themes-section">
      <div class="shell">
        <div class="section-heading reveal">
          <div>
            <p class="overline">What connects the work</p>
            <h2>Four ways into the notebook</h2>
          </div>
          <p>
            The work expands in many directions, but these four notes are the clearest entry points
            into the same underlying control problem.
          </p>
        </div>

        <div class="theme-grid">
          {featuredArcs.map((arc, index) => arc && (
            <a class="theme-card reveal" href={arc.url}>
              <span class="theme-number">0{index + 1}</span>
              <h3>{arc.title}</h3>
              <p>{arc.body}</p>
              <span class="theme-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <div class="more-notes reveal">
          <span>More field notes</span>
          <nav aria-label="More field notes">
            {moreArcs.map((arc) => <a href={arc.url}>{arc.title} <span>↗</span></a>)}
          </nav>
        </div>
      </div>
    </section>

    <section id="about" class="section shell about-section">
      <div class="about-heading reveal">
        <p class="overline">About me</p>
        <h2>A cross-domain path,<br />{" "}<span>on purpose.</span></h2>
      </div>

      <div class="about-copy reveal">
        <p class="about-lead">
          I didn’t arrive in AI through a straight computer-science path. I followed problems that
          seemed consequential, learned the domain, and built whatever layer was missing.
        </p>
        <p>
          That path ran through fermentation science and wet-lab research at Colorado State,
          industrial automation in Trinidad, entrepreneurship, and eventually AI research. The
          throughline is a respect for noisy evidence and systems that have to work outside a demo.
        </p>
        <p>
          Moving between fields is now part of how I work. A retrieval problem can look like a
          control problem; an evaluation failure can look like a measurement problem; a research
          workflow can become infrastructure for an entire group.
        </p>
      </div>

      <ol class="path-list reveal" aria-label="Edward's path">
        <li>
          <span>2023–25</span>
          <strong>Biotech & wet lab</strong>
          <p>Protein expression, cryoprotectant discovery, experimental design, and learning to distrust clean-looking signals.</p>
        </li>
        <li>
          <span>2024–26</span>
          <strong>Industry & operations</strong>
          <p>Industrial controls, P&amp;IDs, regulatory systems, entrepreneurship, and decisions with physical consequences.</p>
        </li>
        <li>
          <span>2025–now</span>
          <strong>AI research & systems</strong>
          <p>Safety, memory, agent behavior, research infrastructure, and accepted work across AI research workshops.</p>
        </li>
      </ol>
    </section>

    <section id="direction" class="now-section">
      <div class="shell now-inner">
        <div class="now-title reveal">
          <p class="overline">Working direction</p>
          <h2>Intelligence<br />{" "}<span>that can be checked.</span></h2>
        </div>
        <div class="now-copy reveal">
          <p class="now-lead">
            I study intelligent systems at Xi’an Jiaotong-Liverpool University while building
            research and infrastructure across evaluation, memory, AI control, and scientific discovery.
          </p>
          <p>
            The long direction is stable even as projects change: make planning more grounded,
            action more bounded, and verification closer to the layer where consequences become real.
          </p>
          <div class="now-actions">
            <a class="primary-link" href="/zh/" lang="zh-CN">中文页面 <span>→</span></a>
            <a href={links.email}>Start a conversation <span>↗</span></a>
          </div>
        </div>
        <p class="now-marginalia reveal">Abundant capability still needs bounded action,<br /><span>inspectable evidence, and accountable consequence.</span></p>
      </div>
    </section>
  </main>

  <footer class="site-footer shell">
    <div>
      <p class="footer-title">Edward Lue Chee Lip</p>
      <p>AI researcher and systems builder.<br />From Trinidad and Tobago; working across systems and scales.</p>
      <p class="footer-note">Built as a notebook, not a résumé.</p>
    </div>
    <a class="footer-email" href={links.email}>eluecheelip@gmail.com</a>
    <div class="footer-links">
      <a href={links.github} target="_blank" rel="noopener">GitHub</a>
      <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={links.x} target="_blank" rel="noopener">X</a>
      <a href="/zh/" lang="zh-CN">中文</a>
    </div>
  </footer>

  <script>
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reducedMotion) {
      document.querySelectorAll(".reveal").forEach((element) => element.classList.add("visible"));
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.06, rootMargin: "0px 0px -4% 0px" });
      document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
    }

    const notes = [
      "I follow consequential problems, not tidy categories.",
      "I would rather expose the machinery than polish the signal.",
      "The interesting work usually crosses more than one abstraction layer.",
    ];
    const noteText = document.querySelector("[data-field-note]");
    const noteIndex = document.querySelector("[data-note-index]");
    const noteCarousel = document.querySelector("[data-note-carousel]");
    const noteDots = Array.from(document.querySelectorAll("[data-note-dot]"));
    let currentNote = 0;
    let noteTimer;
    const showNote = (nextNote) => {
      currentNote = nextNote;
      if (noteText) noteText.textContent = notes[currentNote];
      if (noteIndex) noteIndex.textContent = String(currentNote + 1).padStart(2, "0");
      noteDots.forEach((dot, index) => {
        const active = index === currentNote;
        dot.classList.toggle("active", active);
        dot.setAttribute("aria-pressed", String(active));
      });
    };
    const startNotes = () => {
      if (reducedMotion) return;
      window.clearInterval(noteTimer);
      noteTimer = window.setInterval(() => showNote((currentNote + 1) % notes.length), 5200);
    };
    noteDots.forEach((dot, index) => dot.addEventListener("click", () => {
      showNote(index);
      startNotes();
    }));
    noteCarousel?.addEventListener("mouseenter", () => window.clearInterval(noteTimer));
    noteCarousel?.addEventListener("mouseleave", startNotes);
    noteCarousel?.addEventListener("focusin", () => window.clearInterval(noteTimer));
    noteCarousel?.addEventListener("focusout", startNotes);
    startNotes();
  </script>
</Layout>
