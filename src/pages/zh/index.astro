---
import Layout from "../../layouts/Layout.astro";
import { acceptedPapers, additionalPapers, links, selectedSystems, sitePositioning } from "../../data/site";

const positioning = sitePositioning.zh;
const visibleSystems = selectedSystems.filter((system) => !("public" in system) || system.public !== false);
const allPapers = [...acceptedPapers, ...additionalPapers];
const paperCount = allPapers.length;
const firstAuthorCount = allPapers.filter((paper) => paper.role === "First author").length;
const venueList = [...new Set(allPapers.map((paper) => paper.series))].sort().join("、");
const zhSystemCopy = {
  "eval-evidence": {
    kind: "评估基础设施",
    description: "分数之外，还要留下模型版本、运行框架（harness）、预算、验证器和原始输出；缺了什么，也一并记录。",
  },
  "circuit-compass": {
    kind: "生物医学决策支持",
    description: "针对相互矛盾的生物学结果，比较可能的机制、核对公开数据，再提出能区分这些解释的实验。实现目前未公开。",
  },
  "brewery-control-systems": {
    kind: "工业系统",
    description: "在特立尼达参与啤酒厂自动化、仪表和合规监测，用 P&ID 与 AutoCAD 把控制逻辑落实到设备。",
  },
  "pop2-protein-expression": {
    kind: "湿实验系统",
    description: "带领十人本科团队做蛋白表达实验，用 AI 辅助搜索参数，并记录每轮实验的依据与结果。",
  },
} as const;

const zhSystems = ["eval-evidence", "circuit-compass", "brewery-control-systems", "pop2-protein-expression"]
  .map((slug) => {
    const system = visibleSystems.find((item) => item.slug === slug);
    return system ? { ...system, ...zhSystemCopy[slug] } : undefined;
  })
  .filter((system) => system !== undefined);
---

<Layout
  title={positioning.title}
  description={positioning.description}
  lang="zh-CN"
>
  <div class="zh-page">
    <header class="site-header">
      <div class="shell nav-inner">
        <a class="site-name" href="#top"><span class="site-name-long">Edward Lue Chee Lip</span><span class="site-name-short">Edward</span></a>
        <p class="header-status"><span></span> 苏州 · 智能系统 · 研究笔记</p>
        <nav class="header-actions" aria-label="主导航">
          <a class="cv-quick-link" href="/cv/">简历 <span aria-hidden="true">↗</span></a>
          <a href={links.email}>联系</a>
          <a href="/" lang="en">English</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section id="top" class="hero shell zh-hero">
        <div class="hero-main reveal">
          <p class="overline"><span class="status-dot"></span>Edward 的研究笔记</p>
          <h1>{positioning.hero}<span>{positioning.heroEmphasis}</span></h1>
          <p class="hero-lead">
            {positioning.lead}
          </p>
          <p class="hero-question">{positioning.question} <a href="#notebook">读研究思路 →</a></p>
          <div class="hero-actions">
            <a class="primary-link" href="#research">查看研究 <span>↓</span></a>
            <a href={links.email}>联系我 <span>↗</span></a>
          </div>

          <div class="desk-note" data-note-carousel aria-label="页边笔记">
            <div>
              <span class="desk-note-index">页边笔记 <b data-note-index>01</b>/03</span>
              <p data-field-note>{positioning.notes[0]}</p>
            </div>
            <div class="note-dots" aria-label="选择页边笔记">
              <button class="active" type="button" data-note-dot="0" aria-label="显示笔记 1" aria-pressed="true"></button>
              <button type="button" data-note-dot="1" aria-label="显示笔记 2" aria-pressed="false"></button>
              <button type="button" data-note-dot="2" aria-label="显示笔记 3" aria-pressed="false"></button>
            </div>
          </div>
        </div>

        <aside class="personal-card reveal" aria-label="此刻">
          <p class="card-label">此刻</p>
<figure class="author-portrait"><img src="/edward-github-avatar.png" width="460" height="460" alt="Edward 的插画风格头像，来自他的 GitHub 个人主页" /><figcaption><a href={links.github}>公开 GitHub 头像 ↗</a></figcaption></figure>
        <p class="personal-note">
            我来自特立尼达和多巴哥，现在住在苏州，就读于西交利物浦大学人工智能<span>（智能系统）</span>专业。
          </p>
          <p class="personal-aside">做过湿实验，也做过工业控制。我习惯先问：这个信号是怎么测出来的？</p>
          <div class="personal-index">
            <p>快速索引</p>
            <nav aria-label="页面索引">
              <a href="#research"><span>01</span>研究</a>
              <a href="#systems"><span>02</span>作品</a>
              <a href="#notebook"><span>03</span>研究笔记</a>
              <a href="#about"><span>04</span>关于我</a>
              <a href="#direction"><span>05</span>方向</a>
            </nav>
          </div>
          <div class="personal-links">
            <a href={links.github} target="_blank" rel="noopener">GitHub ↗</a>

          </div>
        </aside>

        <div class="hero-proof hero-proof-text reveal" aria-label="研究方向与公开证据">
          <p><span class="proof-label">已录用</span><strong>{paperCount} 篇研讨会论文 · {firstAuthorCount} 篇第一作者<br />{venueList}</strong></p>
          <p><span class="proof-label">研究方向</span><strong>记忆 · 评估 · 智能体 · AI 控制</strong></p>
          <p><span class="proof-label">公开证据</span><strong>论文 · 代码 · 实验 · 系统笔记</strong></p>
          <p class="proof-note">读结果，<br /><em>也看它的边界。</em></p>
        </div>
      </section>

      <section id="research" class="section shell">
        <div class="section-heading reveal">
          <div>
            <p class="overline">代表研究</p>
            <h2>研究与证据</h2>
          </div>
          <p>2026 年共有 {paperCount} 篇研讨会论文被 {venueList} 录用，其中 {firstAuthorCount} 篇第一作者。这些论文问的是不同问题：记忆为何失效，监督需要哪些信息，评估到底测到了什么。下方解读分别说明实验结果、局限和我的贡献。</p>
        </div>

        <div class="paper-grid">
          {acceptedPapers.map((paper, index) => {
            const Tag = paper.url ? "a" : "article";
            return (
              <Tag
                class="paper-card reveal"
                href={paper.url || undefined}
              >
                <div class="paper-topline">
                  <span class="paper-index">{String(index + 1).padStart(2, "0")} / {String(acceptedPapers.length).padStart(2, "0")}</span>
                  <span class="accepted-pill">已录用</span>
                  <span lang="en">{paper.venue}</span>
                </div>
                <div class="paper-copy">
                  <h3 lang="en">{paper.title}</h3>
                  <p class="paper-subtitle" lang="en">{paper.subtitle}</p>
                  <p class="paper-question">
                    {paper.id === "01" && "检索器找不到答案，是搜索不够好，还是记忆里已经丢了关系？"}
                    {paper.id === "02" && "专家的反馈，真的能教会小模型吗？先检查迁移是否发生，再谈规模。"}
                    {paper.id === "03" && "拿掉一类信息后，智能体在哪一步开始失败？"}
                    {paper.id === "04" && "只看计划够不够？可信模型需要看到什么，才能发现不可信模型的恶意行为？"}
                    {paper.id === "05" && "模型识别的是帕金森病，还是采集数据的医院？"}
                  </p>
                </div>
                <div class="paper-bottom">
                  <span>{paper.role === "First author" ? "第一作者" : "合著"} · {paper.note.includes("poster") ? "海报展示" : "已录用"}</span>
                  <span aria-hidden="true">研究解读（英文） →</span>
                </div>
              </Tag>
            );
          })}
        </div>
        <div class="collab-block reveal">
          <p class="collab-label">其他已录用工作</p>
          <div class="collab-list">
            {additionalPapers.map((paper) => {
              const Tag = paper.url ? "a" : "article";
              return (
                <Tag class="collab-row" href={paper.url || undefined}>
                  <span class="collab-venue" lang="en">{paper.venue}</span>
                  <span class="collab-title" lang="en"><strong>{paper.title}</strong> — {paper.subtitle}</span>
                  <span class="collab-role">合著</span>
                  <span class="collab-arrow" aria-hidden="true">{paper.url ? "→" : ""}</span>
                </Tag>
              );
            })}
          </div>
        </div>
        <div class="research-footnote reveal">
          <p>链接进入英文研究解读，已公开的论文和代码可从那里继续查阅。尚无公开材料的条目只列已确认的信息。</p>
          <p>测量结果稳定，并不说明测到了目标能力。这是构念效度的问题：我们声称在测什么，实际又测到了什么？</p>
        </div>
      </section>

      <section id="notebook" class="section shell">
        <div class="section-heading reveal">
          <div><p class="overline">研究笔记</p><h2>问题不止在模型里</h2></div>
          <p>运行框架负责组织上下文、调用工具、安排执行流程；评估决定什么算成功。模型在这样的环境里行动，而它的输出又可能改变环境。下面三篇笔记沿着这条线展开。</p>
        </div>
        <div class="theme-grid">
          <a class="theme-card reveal" href="/questions/a-zero-needs-adjudication/">
            <span class="theme-number">01</span><h3>零分，说明了什么？</h3>
            <p>做 Terminal Bench 相关评估时，我反复遇到一个问题：失败出在模型、环境、任务定义，还是验证器？只看分数分不清。需要回到执行记录，检查每一步究竟发生了什么。</p><span class="theme-arrow">↗</span>
          </a>
          <a class="theme-card reveal" href={sitePositioning.frameworkUrl}>
            <span class="theme-number">02</span><h3>接下来，谁会用这个答案？</h3>
            <p>一次输出可能变成下一次行动的依据。记忆保留了什么，评估奖励了什么，谁有权采用结果——这些选择会影响下一轮系统。这里讨论的是研究思路，不是某篇论文已证明的结论。</p><span class="theme-arrow">↗</span>
          </a>
          <a class="theme-card reveal" href="/questions/verification-must-touch-reality/">
            <span class="theme-number">03</span><h3>谁有能力说“不”？</h3>
            <p>多找几个模型，不一定得到独立判断。如果它们读的是同一份材料、犯的是同一种错，彼此同意又说明什么？软件测试和物理测量都需要能推翻结果，也都需要检查自身是否可靠。</p><span class="theme-arrow">↗</span>
          </a>
        </div>
        <p class="notes-footnote">我暂时把这个方向称为“分布式可纠正性”（distributed corrigibility）：做出结果的一方，不应独自决定结果是否成立。纠错需要独立的证据、判断和质疑渠道。这是待检验的设想。以上三篇为英文笔记。</p>
      </section>

      <section id="about" class="section shell about-section">
        <div class="about-heading reveal">
          <p class="overline">关于我</p>
          <h2>先找原因，<br /><span>再看边界。</span></h2>
        </div>
        <div class="about-copy reveal">
          <p class="about-lead">
            模型答错了，未必只是模型的问题。我会先看它拿到了哪些信息，再查运行框架如何处理这些信息、测试如何判定对错。原因可能在另一层。
          </p>
          <p>
            在科罗拉多州立大学做发酵科学与湿实验、在特立尼达做工业自动化，后来创业、做 AI 研究，工作对象变了，习惯没有：读数来自仪器，结果依赖条件。先把这些弄清楚，才知道能相信什么。
          </p>
        </div>
        <ol class="path-list reveal" aria-label="Edward 的经历">
          <li><span>2023–25</span><strong>生物技术与实验室</strong><p>蛋白表达、冷冻保护剂发现与实验设计。</p></li>
          <li><span>2024–26</span><strong>工业与运营</strong><p>工业控制、P&amp;ID、监管系统与创业。</p></li>
          <li><span>2025–现在</span><strong>AI 研究与系统</strong><p>安全、记忆、智能体行为与研究基础设施。</p></li>
        </ol>
      </section>

      <section id="systems" class="section shell systems-section">
        <div class="section-heading reveal">
          <div><p class="overline">系统实践</p><h2>我构建的系统</h2></div>
          <p>下面几个项目记录了这套方法怎样落到代码、实验和设备上。</p>
        </div>
        <div class="systems-grid">
          {zhSystems.map((system, index) => (
            <a class="system-card reveal" href={system.url || links.github}>
              <span class="system-index">0{index + 1}</span>
              <div class="system-title"><span class="system-kind">{system.kind}</span><h3 lang="en">{system.name}</h3></div>
              <p>{system.description}</p>
              <span class="system-link">项目笔记（英文） →</span>
            </a>
          ))}
        </div>

        <a class="method-spine reveal" href="/questions/build-the-missing-layer/">
          <div>
            <span class="method-kicker">工作方法</span>
            <h3>每走一步，都留下判断的依据。</h3>
          </div>
          <ol aria-label="Edward 的六阶段工作循环">
            {["观察", "判断", "计划", "行动", "核验", "记录"].map((step, index) => (
              <li><span>0{index + 1}</span>{step}</li>
            ))}
          </ol>
          <strong>查看工作方法（英文） →</strong>
        </a>
      </section>

      <section id="direction" class="now-section">
        <div class="shell now-inner">
          <div class="now-title reveal">
            <p class="overline">工作方向</p>
            <h2>做对了，<br /><span>怎么知道？</span></h2>
          </div>
          <div class="now-copy reveal">
            <p class="now-lead">我现在在苏州读书，继续研究 AI 记忆、评估与控制，也开发支撑这些研究的工具。</p>
            <p>
              我想继续追问：如果一个系统越来越强，谁还能发现它的错误？这既涉及模型和测试，也涉及谁来核验、谁能提出异议，以及异议能否改变决定。制度层面的讨论是研究方向，还不是实验结论。
            </p>
            <div class="now-actions">
              <a class="primary-link" href="/" lang="en">英文主页 <span>→</span></a>
              <a href={links.email}>联系我 <span>↗</span></a>
            </div>
          </div>
          <p class="now-marginalia reveal">答案可以先保留。<br /><span>证据要能找回来，结论要允许改。</span></p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <div><p class="footer-title">Edward Lue Chee Lip</p><p>来自特立尼达和多巴哥，现居苏州。<br />研究智能系统，也动手做实验和工具。</p><p class="footer-note">这里记录问题、结果，以及还没弄清楚的事。</p></div>
        <a class="footer-email" href={links.email}>eluecheelip@gmail.com</a>
        <div class="footer-links">
          <a href={links.github} target="_blank" rel="noopener">GitHub</a>
          <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href="/" lang="en">English</a>
        </div>
      </div>
    </footer>

    <script>
      import { sitePositioning } from "../../data/site";
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reducedMotion) {
        document.querySelectorAll(".reveal").forEach((element) => element.classList.add("visible"));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.06, rootMargin: "0px 0px -4% 0px" });
        document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
      }

      const notes = sitePositioning.zh.notes;
      const noteText = document.querySelector("[data-field-note]");
      const noteIndex = document.querySelector("[data-note-index]");
      const noteCarousel = document.querySelector("[data-note-carousel]");
      const noteDots = Array.from(document.querySelectorAll("[data-note-dot]"));
      let currentNote = 0;
      const showNote = (nextNote, direction) => {
        currentNote = nextNote;
        if (noteText) {
          if (direction && !reducedMotion) {
            noteText.classList.remove("note-in-left", "note-in-right");
            void noteText.offsetWidth;
            noteText.classList.add(direction === "left" ? "note-in-left" : "note-in-right");
          }
          noteText.textContent = notes[nextNote];
        }
        if (noteIndex) noteIndex.textContent = String(nextNote + 1).padStart(2, "0");
        noteDots.forEach((dot, index) => {
          const active = index === nextNote;
          dot.classList.toggle("active", active);
          dot.setAttribute("aria-pressed", String(active));
        });
      };
      noteDots.forEach((dot, index) => dot.addEventListener("click", () => {
        if (index !== currentNote) showNote(index, index > currentNote ? "left" : "right");
      }));
      let touchX = 0;
      let touchY = 0;
      noteCarousel?.addEventListener("touchstart", (event) => {
        touchX = event.touches[0].clientX;
        touchY = event.touches[0].clientY;
      }, { passive: true });
      noteCarousel?.addEventListener("touchend", (event) => {
        const deltaX = event.changedTouches[0].clientX - touchX;
        const deltaY = event.changedTouches[0].clientY - touchY;
        if (Math.abs(deltaX) < 40 || Math.abs(deltaX) < Math.abs(deltaY) * 1.2) return;
        const step = deltaX < 0 ? 1 : -1;
        showNote((currentNote + step + notes.length) % notes.length, step === 1 ? "left" : "right");
      }, { passive: true });
    </script>
  </div>
</Layout>
