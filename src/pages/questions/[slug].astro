---
import ReadingPage from "../../components/ReadingPage.astro";
import OperatingLoop from "../../components/OperatingLoop.astro";
import StrangeLoop from "../../components/StrangeLoop.astro";
import VerificationPipeline from "../../components/VerificationPipeline.astro";
import InstructionForce from "../../components/InstructionForce.astro";
import { researchArcs } from "../../data/site";

export function getStaticPaths() {
  return researchArcs.map((question, index) => {
    const latest = researchArcs.filter((arc) => "cluster" in arc && arc.cluster === "latest");
    const sibling = latest.find((arc) => arc.slug !== question.slug);
    const next =
      "cluster" in question && question.cluster === "latest" && sibling
        ? sibling
        : researchArcs[(index + 1) % researchArcs.length];
    return {
      params: { slug: question.slug },
      props: { question, next },
    };
  });
}

const { question, next } = Astro.props;
const kind = "kind" in question ? question.kind : "Question I keep returning to";
const status = "status" in question ? question.status : "Living field note";
const publicationDate = "publicationDate" in question ? question.publicationDate : "Continuously revised";
---

<ReadingPage
  kind={kind}
  title={question.title}
  lede={question.lede}
  status={status}
  authors="Edward Lue Chee Lip"
  publicationDate={publicationDate}
  evidenceNote={"evidenceNote" in question ? question.evidenceNote : undefined}
  lastVerified={"revised" in question ? question.revised : undefined}
  lastVerifiedLabel="Last revised"
  readTime={"readTime" in question ? question.readTime : "3 min read"}
  pullQuote={"pullQuote" in question ? question.pullQuote : undefined}
  references={"references" in question ? question.references : undefined}
  sections={question.sections}
  backHref="/notes/"
  backLabel="field notes"
  nextHref={`/questions/${next.slug}/`}
  nextLabel={next.title}
>
  {"visual" in question && question.visual === "ooda" && <OperatingLoop slot="visual" />}
  {"visual" in question && question.visual === "verification-pipeline" && <VerificationPipeline slot="visual" />}
  {"visual" in question && question.visual === "instruction-force" && <InstructionForce slot="visual" />}
  {"visual" in question && !["ooda", "verification-pipeline", "instruction-force"].includes(question.visual) && <StrangeLoop slot="visual" compact={question.visual !== "strange-loop"} />}
</ReadingPage>
