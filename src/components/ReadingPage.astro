---
import Layout from "../layouts/Layout.astro";
import type { ReadingSection } from "../data/site";

interface Props {
  kind: string;
  depthAfterBody?: boolean;
  lang?: "en" | "zh-CN";
  title: string;
  subtitle?: string;
  lede: string;
  status?: string;
  evidenceNote?: string;
  sections: readonly ReadingSection[];
  sourceUrl?: string | null;
  sourceLabel?: string;
  resources?: readonly { label: string; url: string }[];
  role?: string;
  authors?: string;
  publicationDate?: string;
  publicationDateLabel?: string;
  artifactState?: string;
  contribution?: string;
  evidenceClass?: string;
  provenance?: string;
  lastVerified?: string;
  lastVerifiedLabel?: string;
  citationState?: string;
  readTime?: string;
  pullQuote?: string;
  references?: readonly { label: string; url: string }[];
  backHref: string;
  backLabel: string;
  nextHref?: string;
  nextLabel?: string;
}

const {
  kind,
  depthAfterBody = false,
  lang = "en",
  title,
  subtitle,
  lede,
  status,
  evidenceNote,
  sections,
  sourceUrl,
  sourceLabel,
  resources,
  role,
  authors,
  publicationDate,
  publicationDateLabel,
  artifactState,
  contribution,
  evidenceClass,
  provenance,
  lastVerified,
  lastVerifiedLabel = "Last checked",
  citationState,
  readTime,
  pullQuote,
  references,
  backHref,
  backLabel,
  nextHref,
  nextLabel,
} = Astro.props;

const zh = lang === "zh-CN";
// Render authored link labels as elements while keeping all prose escaped.
function inlineParts(text: string, links: ReadingSection["inlineLinks"] = []) {
  const parts: { text: string; url?: string }[] = [];
  let remaining = text;
  while (remaining) {
    const match = links
      .filter((link) => link.label.length > 0)
      .map((link) => ({ ...link, index: remaining.indexOf(link.label) }))
      .filter((link) => link.index >= 0)
      .sort((a, b) => a.index - b.index || b.label.length - a.label.length)[0];
    if (!match) {
      parts.push({ text: remaining });
      break;
    }
    if (match.index > 0) parts.push({ text: remaining.slice(0, match.index) });
    parts.push({ text: match.label, url: match.url });
    remaining = remaining.slice(match.index + match.label.length);
  }
  return parts;
}
const isScholarlyArticle = kind.startsWith("Research digest") || kind.startsWith("研究解读");
const pageSchema = {
  "@context": "https://schema.org",
  "@type": isScholarlyArticle ? "ScholarlyArticle" : "Article",
  headline: title,
  ...(subtitle ? { alternativeHeadline: subtitle } : {}),
  description: lede,
  url: Astro.url.href,
  inLanguage: lang,
  author: {
    "@type": "Person",
    name: "Edward Lue Chee Lip",
    url: new URL("/", Astro.site).href,
  },
  // Acceptance text is not an exact publication date; omit rather than invent one.
};
---

<Layout title={`${title} — Edward Lue Chee Lip`} description={lede} lang={lang}>
  <div class:list={[zh && "zh-page"]}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <header class="site-header reading-header">
    <div class="shell nav-inner">
      <a class="site-name" href={zh ? "/zh/" : "/"}><span class="site-name-long">Edward Lue Chee Lip</span><span class="site-name-short">Edward</span></a>
      <p class="header-status"><span></span> {zh ? "研究笔记" : "Field notes"} / {kind}</p>
      <nav aria-label={zh ? "阅读导航" : "Reading navigation"}>
        <a href={backHref}>← {backLabel}</a>
        <a href="/questions/inside-the-loop/">{zh ? "研究框架（英文）" : "Framework"}</a>
        <a href={sourceUrl || "mailto:eluecheelip@gmail.com"} target={sourceUrl ? "_blank" : undefined} rel={sourceUrl ? "noopener" : undefined}>{sourceUrl ? `${sourceLabel || (zh ? "来源" : "Source")} ↗` : (zh ? "联系讨论 ↗" : "Discuss ↗")}</a>
      </nav>
    </div>
  </header>

  <main id="main" class="reading-page">
    <header class="reading-hero shell">
      <div class="reading-title">
        <p class="overline"><span class="status-dot"></span>{kind}</p>
        <h1>{title}</h1>
        {subtitle && <p class="reading-subtitle">{subtitle}</p>}
      </div>
      <aside class="reading-lede">
        <p>{lede}</p>
        {(resources?.length || sourceUrl) && <nav class="artifact-links" aria-label={zh ? "公开论文与代码" : "Public research artifacts"}>
          {(resources ?? [{ label: sourceLabel || (sourceUrl?.includes("arxiv.org") ? "Paper · arXiv" : "Implementation"), url: sourceUrl! }]).map((resource) => <a href={resource.url} target="_blank" rel="noopener">{resource.label} ↗</a>)}
        </nav>}
        {status && <span class="reading-status">{status}</span>}
        {(role || authors || publicationDate || artifactState || readTime) && (
          <dl class="reading-meta-grid">
            {role && <div><dt>{zh ? "我的角色" : "My role"}</dt><dd>{role}</dd></div>}
            {publicationDate && <div><dt>{publicationDateLabel || (zh ? "发表状态" : "Publication status")}</dt><dd>{publicationDate}</dd></div>}
            {authors && <div class="meta-wide"><dt>{zh ? "作者" : "Authors"}</dt><dd>{authors}</dd></div>}
            {artifactState && <div><dt>{zh ? "公开材料" : "Artifacts"}</dt><dd>{artifactState}</dd></div>}
            {readTime && <div><dt>{zh ? "阅读时间" : "Reading time"}</dt><dd>{readTime}</dd></div>}
            {contribution && <div class="meta-wide"><dt>{zh ? "我的贡献" : "My contribution"}</dt><dd>{contribution}</dd></div>}
            {evidenceClass && <div><dt>{zh ? "证据范围" : "Evidence"}</dt><dd>{evidenceClass.replace(/^E\d+ · /, "")}</dd></div>}
            {lastVerified && <div><dt>{lastVerifiedLabel}</dt><dd>{lastVerified}</dd></div>}
            {provenance && <div class="meta-wide"><dt>{zh ? "依据" : "Provenance"}</dt><dd>{provenance}</dd></div>}
            {citationState && <div class="meta-wide"><dt>{zh ? "引用信息" : "Citation"}</dt><dd>{citationState}</dd></div>}
          </dl>
        )}
      </aside>
    </header>

    {pullQuote && (
      <blockquote class="reading-pullquote shell">
        <p>“{pullQuote}”</p>
        <cite>Working note · Edward Lue Chee Lip</cite>
      </blockquote>
    )}

    <slot name="visual" />
    {!depthAfterBody && <slot name="depth" />}

    <div class="reading-body shell">
      <aside class="reading-index" aria-label={zh ? "本页目录" : "On this page"}>
        <p class="card-label">{zh ? "本页目录" : "On this page"}</p>
        <ol>
          {sections.map((section, index) => (
            <li><a href={`#section-${index + 1}`}><span>0{index + 1}</span>{section.title}</a></li>
          ))}
        </ol>
        {evidenceNote && <p class="evidence-note">{evidenceNote}</p>}
        {references && references.length > 0 && (
          <div class="reading-references">
            <p>{zh ? "参考资料" : "References"}</p>
            {references.map((reference) => <a href={reference.url} target="_blank" rel="noopener">{reference.label} ↗</a>)}
          </div>
        )}
      </aside>

      <article class="reading-article">
        {sections.map((section, index) => (
          <section id={`section-${index + 1}`} class="reading-section">
            <p class="section-number">0{index + 1}</p>
            <h2>{section.title}</h2>
            {section.body.map((paragraph) => <p>{inlineParts(paragraph, section.inlineLinks).map((part) => part.url ? <a href={part.url}>{part.text}</a> : part.text)}</p>)}
            {section.code && <pre class="reading-code"><code>{section.code}</code></pre>}
            {section.links && <nav class="section-sources" aria-label={`${zh ? "相关依据：" : "Related evidence for "}${section.title}`}>{section.links.map((link) => <a href={link.url}>{link.label} →</a>)}</nav>}
            {section.points && (
              <ul>
                {section.points.map((point) => <li>{point}</li>)}
              </ul>
            )}
          </section>
        ))}

      </article>
    </div>

    {depthAfterBody && <slot name="depth" />}

    <nav class="reading-next shell" aria-label={zh ? "继续阅读" : "Continue reading"}>
      <a href={backHref}><span>{zh ? "返回" : "Back to"}</span>{backLabel} ←</a>
      {nextHref && <a href={nextHref}><span>{zh ? "继续阅读" : "Continue to"}</span>{nextLabel} →</a>}
    </nav>
  </main>

  <footer class="site-footer reading-footer">
    <div class="shell footer-inner">
      <div><p class="footer-title">Edward Lue Chee Lip</p><p>{zh ? "记录智能系统、测量方法，以及还没弄清楚的问题。" : "A public notebook about intelligent systems, their instruments, and the worlds around them."}</p></div>
      <a class="footer-email" href="mailto:eluecheelip@gmail.com">eluecheelip@gmail.com</a>
      <div class="footer-links"><a href="/map/">{zh ? "全站导航" : "Site map"}</a><a href="/">{zh ? "English" : "Home"}</a><a href="/zh/">中文</a></div>
    </div>
  </footer>

  <script>
    const progress = document.querySelector(".reading-progress span");
    const updateProgress = () => {
      const maximum = document.documentElement.scrollHeight - window.innerHeight;
      const value = maximum > 0 ? window.scrollY / maximum : 0;
      if (progress instanceof HTMLElement) progress.style.transform = `scaleX(${value})`;
    };
    updateProgress();
    window.addEventListener("scroll", updateProgress, { passive: true });
  </script>
  </div>
</Layout>
