---
const phases = [
  {
    id: "observe",
    index: "01",
    label: "Observe",
    input: "traces · failures · outside signal",
    detail: "Instrument first. A run should leave evidence about the environment, the model, the harness, and the change it produced.",
  },
  {
    id: "orient",
    index: "02",
    label: "Orient",
    input: "provenance · constraints · prior runs",
    detail: "Build the system model. Connect what happened to the conditions, histories, permissions, and incentives that made it possible.",
  },
  {
    id: "plan",
    index: "03",
    label: "Plan",
    input: "operation · falsifier · gate",
    detail: "Turn orientation into an evidence contract: hypothesis, provenance, acceptance, falsifier, kill condition, budget, rollback, and the next thread.",
  },
  {
    id: "act",
    index: "04",
    label: "Act",
    input: "bounded agent · deterministic code",
    detail: "Change the system inside a sandbox. The agent handles judgment; code owns known operations, boundaries, and acceptance.",
  },
  {
    id: "verify",
    index: "05",
    label: "Verify",
    input: "independent test · reality · reject",
    detail: "Let a separate gate disagree with the builder. In software this may be a deterministic test; in science it may be an instrument, assay, or lab.",
  },
  {
    id: "remember",
    index: "06",
    label: "Remember",
    input: "lineage · correction · next event",
    detail: "Preserve what was observed, asserted, derived, unavailable, and corrected so the next loop begins from evidence rather than reconstructed lore.",
  },
];
---

<figure class="operating-loop" aria-labelledby="operating-loop-title">
  <header class="operating-loop-heading shell">
    <div>
      <p class="overline">How I work · OODA extended into an evidence system</p>
      <h2 id="operating-loop-title">Find the constraint.<br /><span>Keep the trace.</span></h2>
    </div>
    <p>Boyd’s sketch is the ancestry. My working version adds an explicit plan contract, a verifier that can reject the work, and durable lineage for the next pass.</p>
  </header>

  <div class="operating-loop-canvas shell">
    <div class="ooda-map-scroll" tabindex="0" aria-label="Expanded OODA loop diagram; scroll horizontally on small screens">
      <svg class="ooda-map" viewBox="0 0 1440 650" role="img" aria-label="Expanded observe, orient, decide, act control loop">
        <desc id="ooda-map-desc">Outside information and unfolding circumstances become observations. Orientation combines context, prior experience, new information, constraints, and analysis. A decision is treated as a hypothesis and action as a test. Feed-forward, implicit guidance, and three feedback routes return evidence to observation.</desc>
        <defs>
          <marker id="ooda-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto" markerUnits="strokeWidth">
            <path d="M0 0L9 4.5L0 9Z" />
          </marker>
        </defs>

        <g class="ooda-map-headings">
          <text x="200" y="56">OBSERVE</text>
          <text x="605" y="56">ORIENT</text>
          <text x="975" y="56">DECIDE</text>
          <text x="1245" y="56">ACT</text>
        </g>

        <g class="ooda-map-lines">
          <path d="M48 245H112" />
          <path d="M48 325H112" />
          <path d="M92 470L145 395" />
          <path d="M286 315H390" />
          <path d="M820 315H893" />
          <path d="M1057 315H1170" />
          <path d="M605 150C520 72 286 82 238 222" class="implicit" />
          <path d="M770 150C932 74 1235 90 1245 230" class="implicit" />
          <path d="M605 495V530H220V400" class="feedback" />
          <path d="M975 397V570H200V400" class="feedback" />
          <path d="M1245 395V620H180V400" class="feedback" />
        </g>

        <g class="ooda-map-inputs">
          <text x="104" y="209">OUTSIDE</text><text x="104" y="226">INFORMATION</text>
          <text x="104" y="289">UNFOLDING</text><text x="104" y="306">CIRCUMSTANCES</text>
          <text x="105" y="492">INTERACTION WITH</text><text x="105" y="509">THE ENVIRONMENT</text>
        </g>

        <g class="ooda-map-observe">
          <circle cx="200" cy="315" r="86" />
          <text x="200" y="308">observations</text>
          <text class="sub" x="200" y="333">trace · signal · anomaly</text>
        </g>

        <g class="ooda-map-orient">
          <rect x="390" y="145" width="430" height="350" rx="48" />
          <g class="orientation-links">
            <path d="M568 248L532 278M642 248L678 278M554 320H656M519 370L531 387M691 370L679 387M589 430H621M540 357L645 390M670 357L565 390" />
          </g>
          <circle cx="605" cy="210" r="52" />
          <circle cx="500" cy="320" r="54" />
          <circle cx="710" cy="320" r="54" />
          <circle cx="535" cy="430" r="54" />
          <circle cx="675" cy="430" r="54" />
          <text x="605" y="203">cultural</text><text x="605" y="223">context</text>
          <text x="500" y="313">prior</text><text x="500" y="333">experience</text>
          <text x="710" y="313">analysis &amp;</text><text x="710" y="333">synthesis</text>
          <text x="535" y="423">new</text><text x="535" y="443">information</text>
          <text x="675" y="413">constraints</text><text x="675" y="433">&amp;</text><text x="675" y="453">assumptions</text>
        </g>

        <g class="ooda-map-decide">
          <path d="M975 233L1057 315L975 397L893 315Z" />
          <text x="975" y="308">decision</text>
          <text class="sub" x="975" y="333">hypothesis + gate</text>
        </g>

        <g class="ooda-map-act">
          <rect x="1170" y="235" width="150" height="160" rx="5" />
          <text x="1245" y="308">action</text>
          <text class="sub" x="1245" y="333">bounded test</text>
        </g>

        <g class="ooda-map-labels">
          <text x="338" y="298">FEED FORWARD</text>
          <text x="856" y="298">FEED FORWARD</text>
          <text x="1114" y="298">FEED FORWARD</text>
          <text x="418" y="103">IMPLICIT GUIDANCE &amp; CONTROL</text>
          <text x="974" y="103">IMPLICIT GUIDANCE &amp; CONTROL</text>
          <text class="feedback-label" x="660" y="522">ORIENTATION CHANGES WHAT CAN BE OBSERVED</text>
          <text class="feedback-label" x="700" y="562">THE DECISION UPDATES THE HYPOTHESIS</text>
          <text class="feedback-label" x="760" y="612">ACTION PRODUCES NEW EVIDENCE</text>
        </g>
      </svg>
    </div>

    <p class="ooda-scroll-hint" aria-hidden="true">Swipe to trace the full loop →</p>

    <p class="ooda-map-note">The important part is not the four nouns. Orientation changes observation; decisions are hypotheses; actions are tests; every layer can feed evidence back before a full cycle completes.</p>

    <p class="ooda-inspect">Inspect each phase</p>

    <div class="ooda-track" aria-label="Observe, orient, plan, act, verify, remember">
      {phases.map((phase, index) => (
        <button
          class:list={["ooda-phase", index === 0 && "active"]}
          type="button"
          aria-pressed={index === 0 ? "true" : "false"}
          data-ooda-phase
          data-index={phase.index}
          data-label={phase.label}
          data-detail={phase.detail}
        >
          <span>{phase.index}</span>
          <strong>{phase.label}</strong>
          <em>{phase.input}</em>
          {index < phases.length - 1 && <i aria-hidden="true">→</i>}
        </button>
      ))}
    </div>

    <div class="ooda-feedback" aria-hidden="true">
      <span>feedback becomes the next observation</span>
      <i></i>
      <b>↶</b>
    </div>

    <aside class="ooda-readout" aria-live="polite">
      <span data-ooda-index>01</span>
      <div><p data-ooda-label>Observe</p><strong data-ooda-detail>{phases[0].detail}</strong></div>
    </aside>

    <div class="harness-rails" aria-label="The operating rails beneath the loop">
      <article>
        <span>Plan contract</span>
        <h3>Precommit the evidence.</h3>
        <p>Operation · hypothesis · falsifier · kill · rollback</p>
      </article>
      <article>
        <span>Harness</span>
        <h3>Assemble the capability.</h3>
        <p>Context · model · prompt · tools · memory</p>
      </article>
      <article>
        <span>Workflow</span>
        <h3>Put the graph in code.</h3>
        <p>Phases · typed handoffs · retries · gates · trace</p>
      </article>
      <article>
        <span>Sandbox</span>
        <h3>Bound the consequence.</h3>
        <p>Filesystem · network · secrets · time · writes</p>
      </article>
      <article>
        <span>Verifier</span>
        <h3>Let the gate say no.</h3>
        <p>Tests · reviewers · instruments · receipts · reality</p>
      </article>
    </div>
  </div>

  <figcaption class="shell">The full OODA sketch explains the feedback topology. The six-stage rail explains how I operationalize it.</figcaption>

  <script>
    document.querySelectorAll(".operating-loop").forEach((loop) => {
      const index = loop.querySelector("[data-ooda-index]");
      const label = loop.querySelector("[data-ooda-label]");
      const detail = loop.querySelector("[data-ooda-detail]");
      loop.querySelectorAll("[data-ooda-phase]").forEach((phase) => {
        phase.addEventListener("click", () => {
          loop.querySelectorAll("[data-ooda-phase]").forEach((item) => {
            item.classList.remove("active");
            item.setAttribute("aria-pressed", "false");
          });
          phase.classList.add("active");
          phase.setAttribute("aria-pressed", "true");
          if (index) index.textContent = phase.getAttribute("data-index") || "";
          if (label) label.textContent = phase.getAttribute("data-label") || "";
          if (detail) detail.textContent = phase.getAttribute("data-detail") || "";
        });
      });
    });
  </script>
</figure>
