---
interface Props {
  items: readonly (readonly [string, string])[];
}

const { items } = Astro.props;
---

<section class="research-altitudes" aria-labelledby="research-altitudes-title">
  <header class="shell research-altitudes-heading">
    <div>
      <p class="overline">Research summary</p>
      <h2 id="research-altitudes-title">The question,<br /><span>the test, the limits.</span></h2>
    </div>
    <p>A compact reference for what we tested, what the result supports, and what would challenge it.</p>
  </header>

  <ol class="shell research-altitudes-list">
    {items.map(([label, value], index) => (
      <li>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <strong>{label}</strong>
        <p>{value}</p>
      </li>
    ))}
  </ol>
</section>
