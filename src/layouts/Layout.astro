---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const {
  title,
  description = "Edward Lue Chee Lip — AI researcher and systems builder working across memory, evaluation, safety, and operational intelligence.",
  lang = "en",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const isHomepage = Astro.url.pathname === "/" || Astro.url.pathname === "/zh/";
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Edward Lue Chee Lip",
  url: "https://edward-lcl.github.io/",
  email: "mailto:eluecheelip@gmail.com",
  sameAs: [
    "https://github.com/edward-lcl",
    "https://linkedin.com/in/edward-lue-chee-lip",
    "https://x.com/MushuDev",
  ],
  knowsAbout: ["AI safety", "agent evaluation", "AI memory", "research infrastructure", "biomedical signals"],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f6f3" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="Edward Lue Chee Lip" />
    <meta property="og:locale" content={lang === "zh-CN" ? "zh_CN" : "en_US"} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    {isHomepage && <link rel="alternate" hreflang="en" href="https://edward-lcl.github.io/" />}
    {isHomepage && <link rel="alternate" hreflang="zh-CN" href="https://edward-lcl.github.io/zh/" />}
    {isHomepage && <link rel="alternate" hreflang="x-default" href="https://edward-lcl.github.io/" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === "zh-CN" ? "跳到主要内容" : "Skip to content"}</a>
    <slot />
  </body>
</html>
